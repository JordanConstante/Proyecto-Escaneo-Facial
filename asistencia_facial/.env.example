# Copia este archivo como ".env" y ajusta los valores.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=asistencia_facial
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Solo para pruebas rápidas sin PostgreSQL (descomenta la línea):
USE_SQLITE=1

# Parámetros de reconocimiento (opcionales)
FACE_CONFIDENCE_THRESHOLD=70
FACE_SAMPLES_PER_PERSON=20
